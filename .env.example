# Environment Variables for Aether Office
# Copy to `.env` to configure your environment without modifying yaml files.

# LLM Endpoint Configuration (OpenAI-compatible)
AETHER_LLM_ENDPOINT=http://localhost:11434/v1
AETHER_LLM_API_KEY=your-api-key-here
AETHER_LLM_MODEL=llama3

# Runtime & Logging Settings
AETHER_LOG_LEVEL=INFO
AETHER_DATA_DIR=./data
AETHER_OUTPUT_DIR=./projects
